    <h1 style="max-width:20ch" data-reveal="mask"><span>Buying a home without your name on anything</span></h1>
    <p class="fine" style="margin-top:2rem">Privacy &middot; 5 min read &middot; By Ikem</p>
  </div>
</section>

<section class="wrap">
  <div class="frame ratio-21x9 is-dark" data-slug="Article hero" data-reveal="media">
    <canvas data-ridge="entry-hero" data-ridge-tone="dark" data-ridge-lines="26"></canvas>
    <img src="assets/img/journal-03.jpg" alt="" onerror="this.classList.add('missing')">
  </div>
